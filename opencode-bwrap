#!/bin/bash
set -euo pipefail

OP_DATA="$HOME/.local/share/opencode"
OP_CONFIG="$HOME/.config/opencode"
OP_CACHE="$HOME/.cache/opencode"
OP_STATE="$HOME/.local/state/opencode"

mkdir -p "$OP_DATA" "$OP_CONFIG" "$OP_CACHE" "$OP_STATE"

WORKSPACE="$(pwd)"
NVM_DIR="${NVM_DIR:-$HOME/.nvm}"

exec bwrap \
    --unshare-all \
    --share-net \
    --die-with-parent \
    --new-session \
    --clearenv \
    --proc /proc \
    --dev /dev \
    --tmpfs /tmp \
    --tmpfs /run \
    --ro-bind /usr /usr \
    --symlink usr/lib /lib \
    --symlink usr/lib64 /lib64 \
    --symlink usr/bin /bin \
    --symlink usr/sbin /sbin \
    --ro-bind /etc /etc \
    --tmpfs "$HOME" \
    --setenv HOME "$HOME" \
    --setenv PATH "$PATH" \
    --setenv TMPDIR /tmp \
    --setenv TERM "${TERM:-xterm-256color}" \
    --setenv LANG "${LANG:-C.UTF-8}" \
    --chdir "$WORKSPACE" \
    --bind "$OP_CONFIG" "$OP_CONFIG" \
    --bind "$OP_DATA" "$OP_DATA" \
    --bind "$OP_CACHE" "$OP_CACHE" \
    --bind "$OP_STATE" "$OP_STATE" \
    --ro-bind-try "$NVM_DIR" "$NVM_DIR" \
    --ro-bind-try "$HOME/.opencode/bin" "$HOME/.opencode/bin" \
    --ro-bind-try "$HOME/.gitconfig" "$HOME/.gitconfig" \
    --bind "$WORKSPACE" "$WORKSPACE" \
    -- opencode "$@"
